     "v": 1
    },
    {
     "t": "ssh user {{ADMIN_USER}} service-type stelnet",
     "v": 1
    },
    {
     "t": "user-interface vty 0 4",
     "v": 1
    },
    {
     "t": " authentication-mode aaa",
     "v": 1
    },
    {
     "t": " protocol inbound ssh",
     "v": 1
    },
    {
     "t": " quit",
     "v": 1
    },
    {
     "t": "ntp-service unicast-server {{NTP1}}",
     "v": 1
    },
    {
     "t": "ntp-service unicast-server {{NTP2}}",
     "v": 1
    },
    {
     "t": "info-center loghost {{SYSLOG1}}",
     "v": 1
    },
    {
     "t": "snmp-agent sys-info version v3",
     "v": 1
    },
    {
     "t": "snmp-agent group v3 {{SNMP_GROUP}} privacy",
     "v": 1
    },
    {
     "t": "snmp-agent usm-user v3 {{SNMP_USER}} {{SNMP_GROUP}} authentication-mode sha2-256 {{SNMP_AUTH}} privacy-mode aes128 {{SNMP_PRIV}}",
     "v": 1
    },
    {
     "t": "header login information \"{{BANNER}}\"",
     "v": 1
    }
